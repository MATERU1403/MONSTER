-- Decode the live captures (results/cap_*.json) with the pure codec and compare with what the body really did.
-- Run from the monster-build folder:  lune run tools/analyze_capture
local fs = require("@lune/fs")
local serde = require("@lune/serde")
local Codec = require("../pure/codec")()

local function unhex(h)
	local out = table.create(#h // 2)
	for i = 1, #h, 2 do out[#out + 1] = string.char(tonumber(string.sub(h, i, i + 1), 16)) end
	return table.concat(out)
end

local function showCounts(t)
	local parts = {}
	for k, v in pairs(t) do table.insert(parts, string.format("%s x%d", tostring(k), v)) end
	table.sort(parts)
	return table.concat(parts, ", ")
end

local labels = { "still", "walk", "jump", "nudge" }
local lines = { "# Capture report (generated by tools/analyze_capture.luau)", "" }
local function out(s) table.insert(lines, s); print(s) end

local totalRows, totalStd, headers, lengths = 0, 0, {}, {}
for _, label in ipairs(labels) do
	local path = "results/cap_" .. label .. ".json"
	if fs.isFile(path) then
		local data = serde.decode("json", fs.readFile(path))
		local rows = data.a1 or {}
		out(string.format("## %s: %.2f s, %d x 0xA1, %d fault(s)", label, data.seconds or 0, #rows, data.faults or 0))
		if data.shape then
			out(string.format("- packet object: %s, PacketId %s, meta [%s], members [%s]", tostring(data.shape.luaType), tostring(data.shape.id), tostring(data.shape.meta), tostring(data.shape.members)))
		end
		local others = {}
		for id, o in pairs(data.others or {}) do table.insert(others, { id = id, o = o }) end
		table.sort(others, function(a, b) return a.o.n > b.o.n end)
		for _, e in ipairs(others) do
			out(string.format("- other 0x%s: %d packets (%.1f/s), %s-%s bytes, first bytes %s", e.id, e.o.n, e.o.perSecond or 0, tostring(e.o.min), tostring(e.o.max), tostring(string.sub(e.o.sample or "", 1, 40))))
		end
		if #rows > 0 then
			local posErr, yawErr, deltas, std, bad = {}, {}, {}, 0, 0
			local prevStamp, prevT
			local sizes = {}
			for _, row in ipairs(rows) do
				local packet = unhex(row.hex)
				sizes[#packet] = (sizes[#packet] or 0) + 1
				local parsed, why = Codec.parse(packet)
				if parsed then
					totalRows += 1
					if parsed.standard then std += 1; totalStd += 1 end
					headers[parsed.header] = (headers[parsed.header] or 0) + 1
					lengths[parsed.len] = (lengths[parsed.len] or 0) + 1
					if row.hrp then
						table.insert(posErr, math.sqrt((parsed.x - row.hrp.x) ^ 2 + (parsed.y - row.hrp.y) ^ 2 + (parsed.z - row.hrp.z) ^ 2))
						if parsed.yaw then
							local yaw = math.atan2(-row.hrp.lx, -row.hrp.lz)
							table.insert(yawErr, math.abs(Codec.angleDelta(parsed.yaw, yaw)))
						end
					end
					if prevStamp then table.insert(deltas, (parsed.stamp - prevStamp) / 240) end
					prevStamp = parsed.stamp
				else
					bad += 1
					out("  unparsed packet: " .. tostring(why) .. " " .. string.sub(row.hex, 1, 60))
				end
			end
			table.sort(posErr); table.sort(yawErr); table.sort(deltas)
			local function pct(t, p) return t[math.max(1, math.ceil(#t * p))] end
			local rate = (#rows - 1) / math.max(rows[#rows].t - rows[1].t, 1e-9)
			out(string.format("- decoded %d of %d, standard layout %d, sizes {%s}, %.1f packets/s", #rows - bad, #rows, std, showCounts(sizes), rate))
			if #posErr > 0 then
				out(string.format("- position vs the body after the last physics step: median %.3f, 95th %.3f, max %.3f studs (%d rows)", pct(posErr, 0.5), pct(posErr, 0.95), posErr[#posErr], #posErr))
			end
			if #yawErr > 0 then
				out(string.format("- yaw: median %.4f, 95th %.4f, max %.4f rad (%d rows)", pct(yawErr, 0.5), pct(yawErr, 0.95), yawErr[#yawErr], #yawErr))
			end
			if #deltas > 0 then
				out(string.format("- stamp step between packets: median %.4f s, 95th %.4f s (1/240 s units: %.1f ticks per second of packets)", pct(deltas, 0.5), pct(deltas, 0.95), 1 / math.max(pct(deltas, 0.5), 1e-9) / 1))
			end
		end
		out("")
	end
end

local distinct = 0
for _ in pairs(headers) do distinct += 1 end
out(string.format("## Totals: %d packets decoded, %d standard; %d distinct header(s) over all captures; payload lengths {%s}", totalRows, totalStd, distinct, showCounts(lengths)))
fs.writeFile("results/capture_report.md", table.concat(lines, "\n") .. "\n")
